# =============================================================================
# Example terraform.tfvars for the GCP K8s deployment
#
# Copy to terraform.tfvars and edit. The real file is gitignored.
# =============================================================================

# Your GCP project ID (slug, not number). Find via `gcloud projects list`.
project_id = "your-gcp-project-id"

region = "australia-southeast1"  # Sydney - change to your nearest region
zone   = "australia-southeast1-a"

# Assignment requires 4 vCPU + 8 GB RAM per VM
machine_type      = "n1-custom-4-8192"
worker_count      = 2
boot_disk_size_gb = 30

# Path to the SSH public key authorised on every node
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Docker image to deploy via the K8s manifests
docker_image = "<dockerhub-username>/plastic-detection:v2"
